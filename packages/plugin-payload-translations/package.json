{
  "name": "plugin-payload-translations",
  "version": "0.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server/server.d.mts",
      "import": "./dist/server/server.mjs",
      "default": "./dist/server/server.mjs"
    },
    "./server": {
      "types": "./dist/server/server.d.mts",
      "import": "./dist/server/server.mjs",
      "default": "./dist/server/server.mjs"
    },
    "./client": {
      "types": "./dist/client/client.d.ts",
      "import": "./dist/client/client.js",
      "default": "./dist/client/client.js"
    },
    "./rsc": {
      "types": "./dist/server/rsc.d.mts",
      "import": "./dist/server/rsc.mjs",
      "default": "./dist/server/rsc.mjs"
    }
  },
  "main": "./dist/server/server.mjs",
  "types": "./dist/server/server.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsdown --config-loader tsx && pnpm build:package",
    "build:package": "tsx ../../tools/scripts/build-package.ts",
    "clean": "rimraf dist",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@payloadcms/db-mongodb": "catalog:",
    "@payloadcms/eslint-config": "latest",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "copyfiles": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "graphql": "catalog:",
    "mongodb-memory-server": "11.3.0",
    "next": "catalog:",
    "open": "11.0.4",
    "payload": "catalog:",
    "qs-esm": "8.0.2",
    "rimraf": "catalog:",
    "sharp": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/ui": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/server/server.d.mts",
        "import": "./dist/server/server.mjs",
        "default": "./dist/server/server.mjs"
      },
      "./server": {
        "types": "./dist/server/server.d.mts",
        "import": "./dist/server/server.mjs",
        "default": "./dist/server/server.mjs"
      },
      "./client": {
        "types": "./dist/client/client.d.ts",
        "import": "./dist/client/client.js",
        "default": "./dist/client/client.js"
      },
      "./rsc": {
        "types": "./dist/server/rsc.d.mts",
        "import": "./dist/server/rsc.mjs",
        "default": "./dist/server/rsc.mjs"
      }
    },
    "main": "./dist/server/server.mjs",
    "name": "@konstant/plugin-payload-translations",
    "types": "./dist/server/server.d.mts"
  }
}
