{
  "name": "konstant",
  "version": "7.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "ci:clean": "tsx tools/scripts/clean-install",
    "ci:tag": "tsx tools/scripts/tag-release.ts",
    "ci:version": "tsx tools/scripts/version",
    "ci:version:major": "pnpm ci:version major",
    "ci:version:minor": "pnpm ci:version minor",
    "ci:version:patch": "pnpm ci:version patch",
    "dev": "turbo run dev --filter=web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "sort-packages": "tsx tools/scripts/sort-all-package-jsons.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@repo/eslint-config": "workspace:*",
    "@types/fs-extra": "11.0.4",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "copyfiles": "catalog:",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.1",
    "prettier": "3.10.1",
    "rimraf": "catalog:",
    "semver": "7.8.6",
    "sort-package-json": "4.1.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.11.11",
    "typescript": "catalog:",
    "url": "0.11.4",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
