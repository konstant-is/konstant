{
  "name": "konstant",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "ci:clean": "tsx tools/scripts/clean-install",
    "ci:output": "tsx tools/scripts/create-output",
    "ci:tag": "tsx tools/scripts/tag-release.ts",
    "ci:version": "tsx tools/scripts/version",
    "ci:version:major": "pnpm ci:version major",
    "ci:version:minor": "pnpm ci:version minor",
    "ci:version:patch": "pnpm ci:version patch",
    "depricated:ci:sync:deps": "tsx tools/scripts/sync-deps.js ",
    "depricated:ci:sync:publish": "tsx tools/scripts/sync-publish-package.js && pnpm sort-packages",
    "dev": "turbo run dev --filter=web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "sort-packages": "tsx tools/scripts/sort-all-package-jsons.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@repo/eslint-config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/helpers": "0.5.23",
    "@types/fs-extra": "11.0.4",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "copyfiles": "catalog:",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.1",
    "prettier": "3.9.9",
    "rimraf": "catalog:",
    "semver": "7.8.5",
    "sort-package-json": "4.0.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.11.5",
    "typescript": "catalog:",
    "url": "0.11.4",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
